<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared pieces. Sizes come from the layout (name_pt, price_pt, ...) times the chosen text size (scale). -->
    <template id="label_name">
        <div t-att-style="'font-weight:700;line-height:1.15;overflow:hidden;word-break:break-word;font-size:%.1fpt;max-height:%.1fmm;' % (name_pt * scale, name_mm * scale)">
            <t t-out="label.with_context(display_default_code=False).display_name"/>
        </div>
    </template>

    <template id="label_extra">
        <div t-if="extra_text" t-att-style="'line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:%.1fpt;' % (extra_pt * scale)"
             t-out="extra_text"/>
    </template>

    <template id="label_price">
        <span t-if="show_price" t-att-style="'font-weight:800;white-space:nowrap;font-size:%.1fpt;' % (price_pt * scale)"
              t-out="label.lst_price" t-options="{'widget': 'monetary', 'display_currency': label.currency_id}"/>
    </template>

    <template id="label_code">
        <span t-if="show_code" t-att-style="'font-size:%.1fpt;' % (code_pt * scale)" t-out="label.default_code or ''"/>
    </template>

    <template id="label_barcode">
        <t t-if="show_barcode and label.barcode">
            <div t-out="label.barcode" style="padding:0;line-height:0"
                 t-options="{'widget': 'barcode', 'symbology': 'auto', 'quiet': 0, 'img_style': 'width:%smm;height:%smm;' % (barcode_w, barcode_h)}"/>
            <div style="text-align:center;letter-spacing:0.08em;line-height:1.1;font-size:6pt" t-out="label.barcode"/>
        </t>
    </template>

    <!-- Odoo's PDF body is a Bootstrap "container" (padding, plus 11 mm with o_css_margins) or, without
         styles, has the browser's 8 px margin: either one shifts every label to the right. And Bootstrap's
         table reset (border-style: solid on table rows and cells) makes wkhtmltopdf draw a line around every
         table, row and cell of the label. This resets both; it sits inside the article because Odoo keeps
         only the articles. -->
    <template id="label_page_reset">
        <style>html, body { margin: 0 !important; padding: 0 !important; }
            body.container { max-width: none !important; width: auto !important; }
            .article table, .article thead, .article tbody, .article tfoot, .article tr, .article th, .article td {
                border: 0 none !important; border-width: 0 !important; }</style>
    </template>

    <!-- Every report is one "article": Odoo then wraps it in its minimal layout (UTF-8, report styles).
         Each label box is a little shorter than its page so it can never spill onto an extra page.
         The content of a label sits in a full-height table cell so it is centred from top to bottom. -->

    <!-- 50 x 25 mm barcode label: one label per page -->
    <template id="report_label_50x25">
        <t t-call="web.html_container">
            <t t-set="name_pt" t-value="7.5"/><t t-set="name_mm" t-value="6.6"/>
            <t t-set="extra_pt" t-value="6"/>
            <t t-set="price_pt" t-value="9"/>
            <t t-set="code_pt" t-value="6.5"/>
            <t t-set="barcode_w" t-value="44"/>
            <t t-set="barcode_h" t-value="6.5 if extra_text else 8.5"/>
            <div class="article" style="margin:0;padding:0">
                <t t-call="product_label_builder.label_page_reset"/>
                <t t-foreach="labels" t-as="label">
                    <div t-att-style="'box-sizing:border-box;width:50mm;height:24.6mm;padding:1mm 2.5mm;overflow:hidden;font-family:Arial,Helvetica,sans-serif;color:#000;' + ('' if label_last else 'page-break-after:always;')">
                        <table style="width:100%;height:100%;border-collapse:collapse"><tr><td style="padding:0;vertical-align:middle">
                            <t t-call="product_label_builder.label_name"/>
                            <t t-call="product_label_builder.label_extra"/>
                            <div style="margin-top:0.6mm"><t t-call="product_label_builder.label_barcode"/></div>
                            <table style="width:100%;border-collapse:collapse;margin-top:0.3mm"><tr>
                                <td style="padding:0;vertical-align:bottom"><t t-call="product_label_builder.label_code"/></td>
                                <td style="text-align:right;padding:0;vertical-align:bottom"><t t-call="product_label_builder.label_price"/></td>
                            </tr></table>
                        </td></tr></table>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- 60 x 40 mm price tag: one label per page -->
    <template id="report_label_60x40">
        <t t-call="web.html_container">
            <t t-set="name_pt" t-value="10"/><t t-set="name_mm" t-value="9.4"/>
            <t t-set="extra_pt" t-value="7"/>
            <t t-set="price_pt" t-value="22"/>
            <t t-set="code_pt" t-value="7"/>
            <t t-set="barcode_w" t-value="30"/>
            <t t-set="barcode_h" t-value="7.5"/>
            <div class="article" style="margin:0;padding:0">
                <t t-call="product_label_builder.label_page_reset"/>
                <t t-foreach="labels" t-as="label">
                    <div t-att-style="'box-sizing:border-box;width:60mm;height:39.5mm;padding:2mm 3mm;overflow:hidden;font-family:Arial,Helvetica,sans-serif;color:#000;' + ('' if label_last else 'page-break-after:always;')">
                        <table style="width:100%;height:100%;border-collapse:collapse"><tr><td style="padding:0;vertical-align:middle">
                            <t t-call="product_label_builder.label_name"/>
                            <t t-call="product_label_builder.label_extra"/>
                            <div t-att-style="'height:%.1fmm;line-height:%.1fmm;text-align:center' % ((11 if extra_text else 13), (11 if extra_text else 13))"><t t-call="product_label_builder.label_price"/></div>
                            <table style="width:100%;border-collapse:collapse"><tr>
                                <td style="width:32mm;padding:0;vertical-align:bottom"><t t-call="product_label_builder.label_barcode"/></td>
                                <td style="text-align:right;padding:0;vertical-align:bottom"><t t-call="product_label_builder.label_code"/></td>
                            </tr></table>
                        </td></tr></table>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- A4 sheet, 3 x 8 labels of 66 x 35 mm -->
    <template id="report_label_a4_3x8">
        <t t-call="web.html_container">
            <t t-set="name_pt" t-value="8.5"/><t t-set="name_mm" t-value="7.6"/>
            <t t-set="extra_pt" t-value="6.5"/>
            <t t-set="price_pt" t-value="13"/>
            <t t-set="code_pt" t-value="7"/>
            <t t-set="barcode_w" t-value="58"/>
            <t t-set="barcode_h" t-value="8"/>
            <div class="article" style="margin:0;padding:0">
                <t t-call="product_label_builder.label_page_reset"/>
                <t t-foreach="sheets" t-as="sheet">
                    <div t-att-style="'box-sizing:border-box;width:210mm;height:292mm;padding:8.5mm 0 0 6mm;overflow:hidden;font-family:Arial,Helvetica,sans-serif;color:#000;' + ('' if sheet_last else 'page-break-after:always;')">
                        <table style="border-collapse:collapse;table-layout:fixed">
                            <tr t-foreach="sheet" t-as="row">
                                <td t-foreach="row" t-as="label" style="width:66mm;height:35mm;padding:0;vertical-align:top">
                                    <div style="box-sizing:border-box;width:66mm;height:35mm;padding:2mm 4mm;overflow:hidden">
                                        <table style="width:100%;height:100%;border-collapse:collapse"><tr><td style="padding:0;vertical-align:middle">
                                            <t t-call="product_label_builder.label_name"/>
                                            <t t-call="product_label_builder.label_extra"/>
                                            <div style="margin-top:1mm"><t t-call="product_label_builder.label_barcode"/></div>
                                            <table style="width:100%;border-collapse:collapse;margin-top:0.5mm"><tr>
                                                <td style="padding:0;vertical-align:bottom"><t t-call="product_label_builder.label_code"/></td>
                                                <td style="text-align:right;padding:0;vertical-align:bottom"><t t-call="product_label_builder.label_price"/></td>
                                            </tr></table>
                                        </td></tr></table>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
