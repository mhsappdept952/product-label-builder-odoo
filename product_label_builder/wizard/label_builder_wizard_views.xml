<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_label_builder_wizard_form" model="ir.ui.view">
        <field name="name">product.label.builder.wizard.form</field>
        <field name="model">product.label.builder.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Product Labels">
                <group>
                    <group>
                        <field name="layout" widget="radio"/>
                        <field name="text_size" widget="radio" options="{'horizontal': true}"/>
                        <field name="extra_text" placeholder="e.g. your shop name (up to 40 characters)"/>
                    </group>
                    <group string="Show on the label">
                        <field name="show_price"/>
                        <field name="show_code"/>
                        <field name="show_barcode"/>
                        <field name="label_count"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="barcode"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <div class="alert alert-info mt-3 mb-0" role="status">
                    Need your own label layouts, price-list offers or direct printing to Zebra (ZPL) and TSC / Rongta label printers?
                    <a href="https://apps.odoo.com/apps/modules/19.0/label_studio_pro" target="_blank">Odoo Product Label Builder PRO</a>
                </div>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_label_builder_template" model="ir.actions.act_window">
        <field name="name">Label Builder (PDF)</field>
        <field name="res_model">product.label.builder.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form,kanban</field>
    </record>

    <record id="action_product_label_builder_variant" model="ir.actions.act_window">
        <field name="name">Label Builder (PDF)</field>
        <field name="res_model">product.label.builder.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form,kanban</field>
    </record>
</odoo>
